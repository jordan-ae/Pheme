# --- Database (Supabase) ---
# Use the "Connection string" -> "Transaction pooler" from Supabase project settings.
# IMPORTANT: with the transaction pooler, prepare:false is set in the client.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Memory server auth (AD-07) ---
# Shared key. Acts as the ADMIN key: it mints per-user keys (`memory key:create
# --user you@org.com`) and is the transitional fallback for callers without a
# personal key (their writes are attributed "anonymous"). Generate: openssl rand -hex 32.
# Per-user keys (AD-07 v2) give verified, per-developer authorship — set the minted
# key as MEMORY_API_KEY in each developer's agent config in place of this shared one.
MEMORY_API_KEY=replace-me

# --- Embeddings (AD-11) ---
# Provider-agnostic via Vercel AI SDK. Swap MEMORY_EMBEDDING_PROVIDER/MODEL to change.
MEMORY_EMBEDDING_PROVIDER=openai
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk-...

# --- Bundle size (AD-12) ---
MEMORY_BUNDLE_MAX_TOKENS=3000
MEMORY_BUNDLE_HARD_CEILING=10000

# --- Scribe agent (packages/scribe-agent) ---
# The agent uses Vercel AI SDK so model selection is env-driven (same pattern as AD-11).
# Tools: search_memory, log_entry, supersede_entry, flag_for_review
SCRIBE_AGENT_PORT=5000
SCRIBE_MODEL_PROVIDER=anthropic
SCRIBE_MODEL=claude-sonnet-4-6
SCRIBE_TEMPERATURE=0.2
SCRIBE_MAX_STEPS=10
SCRIBE_MAX_INPUT_CHARS=120000

# Provider keys (set whichever provider you select above)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY also used by embeddings, defined above
# GOOGLE_GENERATIVE_AI_API_KEY=...

# --- Server ---
PORT=4000

# --- MCP wrapper (memory-mcp) ---
# These are read by the MCP stdio server when an agent spawns it.
# Typically set in the agent's mcpServers config (Claude Code, Cursor, Windsurf),
# but listed here as a reference.
MEMORY_SERVER_URL=http://localhost:4000
# Project identity (AD-13). Normally the wrapper derives this from the repo's
# 'origin' git remote, so leave it unset. Set it ONLY for a repo that has no
# remote yet; put it in that repo's own .env so it doesn't apply machine-wide.
# MEMORY_PROJECT=github.com/your-org/your-repo

# --- Dashboard (packages/dashboard) ---
# The authed product surface (port 3002). It reads memory through the REST API
# using the shared MEMORY_API_KEY above (admin), and stores GitHub App
# installations directly in DATABASE_URL (run migration 0007 first).
DASHBOARD_URL=http://localhost:3002

# Public, agent-facing memory-server URL the dashboard shows developers in its
# onboarding ("Connect your agents"). Set this ONLY if the dashboard reaches the
# memory-server at a different (e.g. internal) address than developers' machines
# do — otherwise it falls back to MEMORY_SERVER_URL above. In the hosted product
# this is the public host, e.g. https://memory.pheme.dev.
# MEMORY_PUBLIC_URL=https://memory.pheme.dev

# Session cookie encryption. Any string; a 32-byte key is derived from it.
# Generate: openssl rand -hex 32
SESSION_SECRET=replace-me

# GitHub App (create one at https://github.com/settings/apps — you supply these).
# Permissions: account email (read), repository contents (read), and pull requests
# (read) reserved for future use. Set the App's "Setup URL" to
# $DASHBOARD_URL/api/github/install/callback and enable user authorization (OAuth)
# with callback $DASHBOARD_URL/api/auth/github/callback.
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_ID=123456
GITHUB_APP_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_APP_CLIENT_SECRET=replace-me
# PEM contents on one line with literal \n between lines (or a real multiline value).
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
